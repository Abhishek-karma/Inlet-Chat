{
  "systemSetup": [
    {
      "name": "Install JDK 17",
      "command": "mkdir -p \"$HOME/.local\" && curl -fsSL -o /tmp/jdk17.tar.gz \"https://api.adoptium.net/v3/binary/latest/17/ga/linux/x64/jdk/hotspot/normal/eclipse?project=jdk\" && mkdir -p \"$HOME/.local/jdk17\" && tar -xzf /tmp/jdk17.tar.gz -C \"$HOME/.local/jdk17\" --strip-components=1 && rm /tmp/jdk17.tar.gz && \"$HOME/.local/jdk17/bin/java\" -version"
    },
    {
      "name": "Install Android cmdline-tools",
      "command": "export ANDROID_HOME=\"$HOME/.local/android-sdk\" && mkdir -p \"$ANDROID_HOME/cmdline-tools\" && curl -fsSL -o /tmp/cmdtools.zip \"https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip\" && unzip -q /tmp/cmdtools.zip -d /tmp/cmdtools && mkdir -p \"$ANDROID_HOME/cmdline-tools\" && mv /tmp/cmdtools/cmdline-tools \"$ANDROID_HOME/cmdline-tools/latest\" && rm /tmp/cmdtools.zip && rm -rf /tmp/cmdtools && ls \"$ANDROID_HOME/cmdline-tools/latest/bin\""
    },
    {
      "name": "Install Android SDK packages",
      "command": "export JAVA_HOME=\"$HOME/.local/jdk17\" && export ANDROID_HOME=\"$HOME/.local/android-sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH\" && yes | sdkmanager --sdk_root=\"$ANDROID_HOME\" --licenses >/dev/null 2>&1; sdkmanager --sdk_root=\"$ANDROID_HOME\" \"platform-tools\" \"platforms;android-35\" \"build-tools;34.0.0\""
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Resolve Dependencies",
      "command": "export JAVA_HOME=\"$HOME/.local/jdk17\" && export ANDROID_HOME=\"$HOME/.local/android-sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH\" && export GRADLE_OPTS=\"-Xmx1024m -Dfile.encoding=UTF-8\" && ./gradlew :app:dependencies --no-daemon -Dorg.gradle.jvmargs=\"-Xmx1536m -XX:MaxMetaspaceSize=512m\" --max-workers=2"
    }
  ],
  "codeChecks": [
    {
      "name": "Run Unit Tests",
      "command": "export JAVA_HOME=\"$HOME/.local/jdk17\" && export ANDROID_HOME=\"$HOME/.local/android-sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH\" && export GRADLE_OPTS=\"-Xmx1024m -Dfile.encoding=UTF-8\" && ./gradlew :app:testDebugUnitTest --no-daemon -Dorg.gradle.jvmargs=\"-Xmx1536m -XX:MaxMetaspaceSize=512m\" --max-workers=2"
    },
    {
      "name": "Run Android Lint",
      "command": "export JAVA_HOME=\"$HOME/.local/jdk17\" && export ANDROID_HOME=\"$HOME/.local/android-sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH\" && export GRADLE_OPTS=\"-Xmx1024m -Dfile.encoding=UTF-8\" && ./gradlew :app:lintDebug --no-daemon -Dorg.gradle.jvmargs=\"-Xmx1536m -XX:MaxMetaspaceSize=512m\" --max-workers=2"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Debug APK",
      "command": "export JAVA_HOME=\"$HOME/.local/jdk17\" && export ANDROID_HOME=\"$HOME/.local/android-sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH\" && export GRADLE_OPTS=\"-Xmx1024m -Dfile.encoding=UTF-8\" && ./gradlew :app:assembleDebug --no-daemon -Dorg.gradle.jvmargs=\"-Xmx1536m -XX:MaxMetaspaceSize=512m\" --max-workers=2"
    },
    {
      "name": "Build Release APK",
      "command": "export JAVA_HOME=\"$HOME/.local/jdk17\" && export ANDROID_HOME=\"$HOME/.local/android-sdk\" && export PATH=\"$JAVA_HOME/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH\" && export GRADLE_OPTS=\"-Xmx1024m -Dfile.encoding=UTF-8\" && ./gradlew :app:assembleRelease --no-daemon -Dorg.gradle.jvmargs=\"-Xmx1536m -XX:MaxMetaspaceSize=512m\" --max-workers=2"
    }
  ],
  "runStep": [],
  "deploySteps": [],
  "cleanupFiles": [
    "app/build",
    "build",
    ".gradle",
    "local.properties",
    ".env"
  ],
  "packageManager": "gradle",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
