<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon for system window splash: identical 108dp x 108dp geometry and
    centering as the adaptive icon foreground for a seamless 1:1 window morph.
    The colour is a resource so the mark stays legible on both splash surfaces.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.4"
        android:scaleY="2.4"
        android:translateX="25.2"
        android:translateY="25.2">
        <path
            android:pathData="M3,3 L9,3 L9,16 L15,16 L15,7 L21,7 L21,21 L3,21 Z"
            android:fillColor="@color/inlet_mark" />
    </group>
</vector>