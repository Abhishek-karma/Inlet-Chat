<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon for the Android 12+ system splash. The system renders it inside
    a circular mask and scales it to 2/3 of the screen, so the mark sits in a
    108dp canvas at 60% of the centre to leave the mask room to crop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.35"
        android:scaleY="1.35"
        android:translateX="23.76"
        android:translateY="23.08">
        <path
            android:pathData="M 9.8,15 a 3.2,3.2 0 1,0 6.4,0 a 3.2,3.2 0 1,0 -6.4,0 Z"
            android:fillColor="#0D9488" />
        <path
            android:pathData="M 13,21 L 13,34"
            android:strokeColor="#0D9488"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 24,14 L 24,34 L 35,34"
            android:strokeColor="#0D9488"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>