<?xml version="1.0" encoding="utf-8"?>
<!--
    Inlet mark. The "I" is the tall left stem, the "L" is the foot turning off
    it, and the shorter right riser closes the foot into a channel. The identity
    is the open negative space between the two walls. Every stroke is 6 units on
    a 24 grid and the shape is one closed axis-aligned path, so the launcher,
    monochrome, splash and in-app sizes all render the identical silhouette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M3,3 L9,3 L9,16 L15,16 L15,7 L21,7 L21,21 L3,21 Z"
        android:fillColor="#00696B" />
</vector>
