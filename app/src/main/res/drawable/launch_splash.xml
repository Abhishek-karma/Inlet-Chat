<?xml version="1.0" encoding="utf-8"?>
<!--
    Launch window shown while the process starts (pre-Android 12).
    Background matches the app surface in each mode so there is no color flash,
    and the mark is centered at identical 108dp size as adaptive icon.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="108dp"
        android:height="108dp"
        android:drawable="@drawable/splash_icon"
        android:gravity="center" />
</layer-list>