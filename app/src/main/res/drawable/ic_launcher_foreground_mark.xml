<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: the "iL" mark on a 108dp adaptive-icon canvas. The
    mark's own artwork occupies the middle 26 units, so it is scaled to sit
    inside the 66dp safe area that launcher masks never crop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.75"
        android:scaleY="1.75"
        android:translateX="14.8"
        android:translateY="13.93">
        <path
            android:pathData="M 9.8,15 a 3.2,3.2 0 1,0 6.4,0 a 3.2,3.2 0 1,0 -6.4,0 Z"
            android:fillColor="#2DD4BF" />
        <path
            android:pathData="M 13,21 L 13,34"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M 24,14 L 24,34 L 35,34"
            android:strokeColor="#2DD4BF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>