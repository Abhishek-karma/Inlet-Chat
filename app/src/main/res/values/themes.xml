<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.InletChat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!--
        Launch theme. Shown only for the launch frame: the activity switches to
        Theme.InletChat in MainActivity before the first frame is drawn.
    -->
    <style name="Theme.InletChat.Splash" parent="Theme.InletChat">
        <item name="android:windowBackground">@drawable/launch_splash</item>
    </style>
</resources>
